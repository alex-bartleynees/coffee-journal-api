# Copy to .env for local development:  cp .env.example .env
# .env is gitignored — never commit real secrets. All vars have safe dev
# defaults (see src/config.ts), so the service also boots with no .env at all.

# HTTP listen port
PORT=3001

# Postgres connection string
DATABASE_URL=postgres://postgres@localhost:5433/coffee_journal

# Keycloak access-token verification.
# Leave KEYCLOAK_JWKS_URL empty to run in DEV auth mode (trusts an `x-dev-user`
# header instead of a real JWT). docker-compose defaults these to the hosted
# shared realm; set them here only to override.
KEYCLOAK_JWKS_URL=
KEYCLOAK_ISSUER=

# --- docker-compose stack (docker-compose.yml) ---
# Postgres superuser password for the compose postgres service.
POSTGRES_PASSWORD=postgres
# Client secret of the "coffee-journal" Keycloak client (create it in the shared
# realm on the hosted identity server — same pattern as the dopamine-kick client).
COFFEE_JOURNAL_CLIENT_SECRET=

# RabbitMQ credentials for the compose broker (defaults bloom/bloom).
RABBITMQ_USER=bloom
RABBITMQ_PASS=bloom

# --- payments-gateway (Stripe; use TEST-mode keys locally) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# The Stripe Price id of the Bloom subscription (create in the Stripe dashboard).
STRIPE_COFFEE_JOURNAL_PRICEID=
