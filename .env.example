# Copy to .env for local development:  cp .env.example .env
# .env is gitignored — never commit real secrets.

# HTTP listen port
PORT=3001

# Postgres connection string
DATABASE_URL=postgres://postgres@localhost:5433/coffee_journal

# Keycloak access-token verification is required in every environment.
KEYCLOAK_JWKS_URL=https://identity.alexbartleynees.com/realms/development/protocol/openid-connect/certs
KEYCLOAK_ISSUER=https://identity.alexbartleynees.com/realms/development

# Read-only MCP transport scaffold. It stays unavailable unless explicitly
# enabled with complete OAuth resource-server settings and a database access
# grant. Grants use Keycloak subject (`sub`) values, never emails.
MCP_ENABLED=false
MCP_RESOURCE_URL=
MCP_AUDIENCE=
MCP_REQUIRED_SCOPE=coffee-journal:read

# Keycloak service account for creating users. Email verification is deliberately
# not required yet: created users have emailVerified=false and no required action.
KEYCLOAK_ADMIN_BASE_URL=https://identity.alexbartleynees.com
KEYCLOAK_ADMIN_REALM=development
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_CLIENT_SECRET=

# --- docker-compose stack (docker-compose.yml) ---
# Postgres superuser password for the compose postgres service.
POSTGRES_PASSWORD=postgres
# Client secret of the "coffee-journal" Keycloak client (create it in the shared
# realm on the hosted identity server — same pattern as the dopamine-kick client).
COFFEE_JOURNAL_CLIENT_SECRET=
# Service-account secret used by coffee-journal-api to create Keycloak users.
ADMIN_CLIENT_SECRET=

# RabbitMQ credentials for the compose broker (defaults bloom/bloom).
RABBITMQ_USER=bloom
RABBITMQ_PASS=bloom

# --- payments-gateway (Stripe; use TEST-mode keys locally) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# The Stripe Price id of the Bloom subscription (create in the Stripe dashboard).
STRIPE_COFFEE_JOURNAL_PRICEID=

# Backblaze B2 S3-compatible storage for subscriber bean-photo sync.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Server-only OpenRouter credentials for subscriber bean-label extraction.
OPENROUTER_API_KEY=
AI_BEAN_EXTRACTION_MODEL=google/gemini-2.5-flash-lite
