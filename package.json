{
  "name": "coffee-journal-api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Sync backend for the Bloom coffee journal app — Node/Effect.ts, Postgres, last-write-wins delta sync.",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/index.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "test": "npm run test:types && vitest run --reporter=verbose",
    "test:types": "tsc --project tsconfig.test.json --noEmit",
    "check": "tsc --noEmit",
    "build": "tsc"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@effect/opentelemetry": "^0.64.0",
    "@effect/platform": "^0.97.1",
    "@effect/platform-node": "^0.108.1",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-logs-otlp-grpc": "^0.221.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.38.0",
    "ai": "^7.0.73",
    "amqplib": "^2.0.1",
    "effect": "^3.22.1",
    "jose": "^6.1.0",
    "postgres": "^3.4.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testcontainers/minio": "^12.1.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@testcontainers/rabbitmq": "^12.1.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  }
}
